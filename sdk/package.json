{
  "name": "@pulsertc/client",
  "version": "0.1.0",
  "description": "Browser SDK for PulseRTC — realtime audio/video rooms.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/raulhrosa/pulsertc", "directory": "sdk" },
  "keywords": ["webrtc", "sfu", "pulsertc", "video", "realtime"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.19.43",
    "happy-dom": "^15.7.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
