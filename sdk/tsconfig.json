{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "stripInternal": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "outDir": "dist"
  },
  "include": ["src", "tests", "e2e", "playwright.config.ts"]
}
