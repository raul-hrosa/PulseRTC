# PulseRTC configuration. Copy to .env and adjust. .env is gitignored — never
# commit real secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8090
WEB_DIR=web

# ---------------------------------------------------------------------------
# SFU / ICE
# ---------------------------------------------------------------------------
SFU_UDP_PORT=8091
SFU_NAT_1TO1_IP=127.0.0.1
# SFU_NACK_BUFFER_SIZE=256
# SFU_NEGOTIATION_CONCURRENCY=
# Per-subscriber send-queue depth, in packets (ADR 012). A slow subscriber
# drops on its own queue instead of stalling the room.
# SFU_SUBSCRIBER_QUEUE_AUDIO=64
# SFU_SUBSCRIBER_QUEUE_VIDEO=512

# ICE servers offered to browsers (also sent in the `welcome` message).
# STUN defaults to Google when unset. For an open audience, run a TURN server
# (docker compose --profile turn up) and set all three TURN vars — a TURN URL
# without credentials is ignored.
# PULSERTC_STUN_URLS=stun:stun.l.google.com:19302
# PULSERTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# PULSERTC_TURN_USERNAME=
# PULSERTC_TURN_PASSWORD=

# ---------------------------------------------------------------------------
# Security / Authentication
# ---------------------------------------------------------------------------
# Master switch. Defaults to true: an unconfigured server fails closed. Set to
# false ONLY for local development.
PULSERTC_AUTH_ENABLED=true

# HS256 signing secret shared with whatever mints tokens. REQUIRED when auth is
# enabled — the server refuses to start without it. Use a long random value.
PULSERTC_JWT_SECRET=change-me-use-a-long-random-secret

# Expected "iss" / "aud" claims. A token issued for another service is rejected.
PULSERTC_JWT_ISSUER=pulsertc
PULSERTC_JWT_AUDIENCE=pulsertc

# Accepted "alg" header values (comma separated). HMAC only, for now.
PULSERTC_JWT_ALGS=HS256

# Replay window: a token whose "iat" is older than this is rejected even if it
# has not expired. Keep it short. 0 disables the check.
PULSERTC_TOKEN_MAX_AGE=1h

# Largest inbound WebSocket frame. The biggest legitimate message is an SDP
# offer (~2-8 KiB); 64 KiB is generous headroom.
PULSERTC_MAX_MESSAGE_SIZE=65536

# Basic abuse protection. RATE_LIMIT = new connections + auth attempts per
# client IP per minute. MSG_RATE = signaling messages per connection per second.
# 0 disables the respective limiter.
PULSERTC_RATE_LIMIT=120
PULSERTC_MSG_RATE=100

# Keep /metrics (Prometheus), /metrics.json (legacy), /sfu/stats and /debug/pprof
# reachable without a token. Health is always public. Development / trusted-network only.
# For Prometheus scrape_config: use a bearer token (generated with cmd/token)
# or set this to true (not recommended for production).
PULSERTC_METRICS_PUBLIC=false

# ---------------------------------------------------------------------------
# Cluster / Multi-Node
# ---------------------------------------------------------------------------
# Master switch. Default false: the server behaves exactly like a single node
# (no /internal API, every room resolves locally).
PULSERTC_CLUSTER_ENABLED=false

# This node's identity. Generated if unset; set it explicitly in a real cluster.
PULSERTC_NODE_ID=

# How other nodes reach this one's /internal API. Host defaults to the
# container/host name; port defaults to PORT.
PULSERTC_NODE_HOST=
PULSERTC_NODE_PORT=

# Shared secret authenticating node-to-node /internal calls. REQUIRED when
# clustering is enabled — the server refuses to start without it. This is NOT
# the user JWT secret (different trust context).
PULSERTC_CLUSTER_SECRET=

# Comma-separated base URLs of the other nodes (static discovery).
# e.g. http://pulsertc-node-02:8090
PULSERTC_CLUSTER_PEERS=

# Heartbeat cadence and the age after which a silent node is reported stale.
# PULSERTC_NODE_TTL is an alias used as the default for STALE_AFTER when the
# latter is unset.
PULSERTC_CLUSTER_HEARTBEAT=5s
PULSERTC_CLUSTER_STALE_AFTER=15s
# PULSERTC_NODE_TTL=15s

# ---------------------------------------------------------------------------
# Failure Detection & Recovery
# ---------------------------------------------------------------------------
# When a node's heartbeat lapses the cluster marks it OFFLINE and lets another
# node take over its rooms so NEW participants can still join. Existing WebRTC
# sessions on the dead node are lost — transparent session recovery is a
# separate mechanism (see below). All settings apply only when clustering is
# enabled.

# How often the failure detector scans known nodes (O(nodes), never per packet
# or per participant). Default 5s.
PULSERTC_FAILURE_CHECK_INTERVAL=5s

# Extra wait after a node's heartbeat window lapses before it is declared
# OFFLINE. Absorbs a GC pause / brief network or Redis blip so a healthy node is
# not falsely recovered. Default 5s.
PULSERTC_FAILURE_GRACE_PERIOD=5s

# Max rooms recovered in parallel after a node fails — bounds the recovery storm
# when a busy node dies. Default 4.
PULSERTC_RECOVERY_CONCURRENCY=4

# Master switch for room recovery. Default true. Set false to only DETECT
# failures (mark nodes OFFLINE, stop routing to them) without any takeover.
# Recovery is always fail-closed: with Redis unreachable nothing is recovered
# and no ownership changes.
PULSERTC_RECOVERY_ENABLED=true

# ---------------------------------------------------------------------------
# Session Recovery & Reconnection
# ---------------------------------------------------------------------------
# After a node fails and S14A moves the room to another node, clients detect the
# lost WebSocket, reconnect (to whichever node now owns the room), build a brand
# new PeerConnection and rejoin — carrying their session id + generation +
# publish/subscribe intent. PeerConnections / ICE / DTLS / SRTP are never
# migrated; there is always a brief media gap.

# Master switch. Default true. When false the server drops the session model and
# behaves exactly like earlier: a lost connection is a plain disconnect.
PULSERTC_SESSION_RECOVERY_ENABLED=true

# How long a logical session may sit in RECOVERING before the server closes it.
# Prevents sessions stuck forever when a client never comes back.
PULSERTC_SESSION_RECOVERY_TIMEOUT=30s

# Advisory reconnect backoff the server hands to the client in room_joined so
# every client in the deployment retries with the same discipline. Delay for
# attempt n = min(initial*2^n, max) plus up to `jitter` extra. Accepts "20%" or
# "0.2" for the jitter.
PULSERTC_RECONNECT_INITIAL_DELAY=500ms
PULSERTC_RECONNECT_MAX_DELAY=10s
PULSERTC_RECONNECT_JITTER=20%

# ---------------------------------------------------------------------------
# Cross-Node Signaling
# ---------------------------------------------------------------------------
# Node→node signaling transport (POST /internal/cluster/messages). Media never
# uses this path — only signaling frames, participant control and room events.
# All of these are only consulted when clustering is enabled.

# Per node→node request timeout. A cross-node send never blocks longer than
# this (plus bounded retry). Raise only on a slow/high-latency network; too
# high defeats the point of failing fast. Default 2s.
PULSERTC_CLUSTER_REQUEST_TIMEOUT=2s

# Bounded retry attempts for a failed send (small exponential backoff, capped by
# the request context). 0 disables retry. Default 2.
PULSERTC_CLUSTER_MAX_RETRIES=2

# Maximum cluster message payload / HTTP body. Larger messages are rejected
# (CLUSTER_MESSAGE_TOO_LARGE / 413). Default 64 KiB — matches the public
# WebSocket frame limit.
PULSERTC_CLUSTER_MAX_MESSAGE_SIZE=65536

# Reject cluster messages whose timestamp is older than this (simple replay
# protection + dropping stuck messages). A generous forward clock-skew is always
# tolerated. Default 30s.
PULSERTC_CLUSTER_MESSAGE_MAX_AGE=30s

# ---------------------------------------------------------------------------
# Cross-Node Media — SFU ↔ SFU
# ---------------------------------------------------------------------------
# Dedicated UDP transport so participants in the same room on different nodes
# can exchange RTP/RTCP. Media NEVER flows through Redis or the signaling HTTP
# path. Authenticated with PULSERTC_CLUSTER_SECRET (HMAC HELLO handshake).
# Default false: single-node / behavior is unchanged, and local
# participants are never forced through this transport.
PULSERTC_MEDIA_ENABLED=false

# UDP bind address and port for inter-SFU RTP+RTCP (multiplexed on one socket).
# In Docker keep this on the internal network only — do not publish it to the
# internet without a reason.
PULSERTC_MEDIA_BIND_ADDR=0.0.0.0
PULSERTC_MEDIA_PORT=10000

# Host other nodes use to reach this node's media port. Defaults to
# PULSERTC_NODE_HOST. Set it when the bind address is not routable from peers.
PULSERTC_MEDIA_ADVERTISE_HOST=

# Media session handshake timeout, largest inter-node datagram payload (keep at
# or below the path MTU to avoid IP fragmentation), and the no-traffic
# window after which a session is declared lost.
PULSERTC_MEDIA_REQUEST_TIMEOUT=2s
PULSERTC_MEDIA_MAX_PACKET_SIZE=1500
PULSERTC_MEDIA_SESSION_TIMEOUT=10s
PULSERTC_MEDIA_HEARTBEAT_INTERVAL=2s

# Per-session outbound queue depth. A slow/lossy peer drops packets for its own
# session only once this fills — it never blocks the socket or other sessions.
PULSERTC_MEDIA_SEND_QUEUE=1024

# ---------------------------------------------------------------------------
# Load Balancing / Room Routing
# ---------------------------------------------------------------------------
# The RoomRouter picks which node a NEW room is created on (least-loaded). It is
# never on the RTP path — only room creation / join / node selection.
# Existing rooms are never re-routed; ClaimOwner stays the authority
# for ownership. All settings apply only when clustering is enabled.

# How often each node aggregates its local counts and publishes a NodeLoad to
# the shared state (with a 3x TTL). Never per RTP packet. Default 2s.
PULSERTC_LOAD_REPORT_INTERVAL=2s

# Per-node capacity caps. 0 = no explicit limit. A node at/above the hard-limit
# fraction of any cap is excluded from new rooms; if every node is excluded the
# router returns NO_CAPACITY.
PULSERTC_NODE_MAX_ROOMS=0
PULSERTC_NODE_MAX_PARTICIPANTS=0
PULSERTC_NODE_MAX_PUBLICATIONS=0
PULSERTC_NODE_SOFT_LIMIT=0.8
PULSERTC_NODE_HARD_LIMIT=1.0

# ---------------------------------------------------------------------------
# Redis / Distributed State
# ---------------------------------------------------------------------------
# When enabled, node registry / room ownership / participant location live in
# Redis so every node shares one consistent view. Redis is used for COORDINATION
# ONLY — never for media (RTP/RTCP/SDP/ICE stay local to each node).
# Default false: the cluster uses the in-memory backend (single node, tests, CI).
PULSERTC_REDIS_ENABLED=false

# Redis address, password and DB. Never hardcode a real password — inject it.
PULSERTC_REDIS_ADDR=redis:6379
PULSERTC_REDIS_PASSWORD=
PULSERTC_REDIS_DB=0

# Key namespace. Every key is "<prefix>:nodes:*", "<prefix>:rooms:*",
# "<prefix>:participants:*" — pick a unique prefix per deployment.
PULSERTC_REDIS_PREFIX=pulsertc

# When true (default), Redis is a hard dependency: the node refuses to become
# READY and fails joins closed (CLUSTER_STATE_UNAVAILABLE) while Redis is
# unreachable. Set false to allow degraded start.
PULSERTC_REDIS_REQUIRED=true

# Command / dial timeout and optional connection pool size.
PULSERTC_REDIS_TIMEOUT=3s
# PULSERTC_REDIS_POOL_SIZE=

# Key TTLs. Node and participant keys expire unless refreshed by the heartbeat /
# session. Room ownership has no TTL by default — it is released
# explicitly when a room empties; set a value to enable failover-style
# expiry later.
PULSERTC_REDIS_NODE_TTL=15s
PULSERTC_REDIS_PARTICIPANT_TTL=60s
PULSERTC_REDIS_ROOM_TTL=0

# ---------------------------------------------------------------------------
# Integration API (v1)
# ---------------------------------------------------------------------------
# Public HTTP control-plane API for an external application. Control plane only:
# it never sits in the RTP path. The join + WebRTC negotiation + Session
# Recovery stay on the WebSocket (/ws); /internal stays cluster-only.

# Enabled by default (mirrors the fail-closed posture). false = the
# middleware is a no-op (development only).
PULSERTC_API_ENABLED=true

# Application credentials, distinct from the participant JWT and the cluster
# secret. Format: "key:scope,scope ; key2:*". Scopes: rooms:create, rooms:read,
# rooms:close, tokens:create, participants:read, quality:read. Never send an API
# key to the browser.
PULSERTC_API_KEYS=

# Per-API-key request budget (requests/minute). Separate from the WebSocket
# message rate limit.
PULSERTC_API_RATE_LIMIT=600

# Advertised to the app for GET /v1/rooms/:id/connection and the "connection"
# block of POST /v1/rooms. Required for those to work.
PULSERTC_PUBLIC_WS_URL=

# Participant token lifetime: default and hard cap.
PULSERTC_API_TOKEN_TTL=1h
PULSERTC_API_TOKEN_TTL_MAX=12h

# When false (default) a token request asking for the CONTROL permission is
# refused with FORBIDDEN — an extra guard against minting admin tokens.
PULSERTC_API_ALLOW_CONTROL_TOKENS=false

# How long a CLOSED / idle room metadata record is retained before it is swept.
PULSERTC_API_ROOM_TTL=5m

# Outbound webhooks (optional). Empty URL = disabled (zero overhead). One URL,
# HMAC-signed with the secret, in-memory buffer, bounded retry, no queue.
# Events: room.created, room.closed, participant.joined, participant.left.
PULSERTC_WEBHOOK_URL=
PULSERTC_WEBHOOK_SECRET=
